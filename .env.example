# Google Gemini API Key
GEMINI_API_KEY=sua_chave_gemini_aqui

# Conexão PostgreSQL Local (Nexus ERP)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nexus_erp
PG_USER=postgres
PG_PASSWORD=sua_senha_postgres
PG_READONLY_USER=nexus_mcp_ro
PG_READONLY_PASSWORD=sua_senha_readonly

# Servidor ERP Datasul (Opcional - integração direta)
DATASUL_API_URL=http://10.0.0.100:8080
DATASUL_USER=usuario_api
DATASUL_PASSWORD=senha_api
